WIDTH=32;
DEPTH=16384;
ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;
CONTENT BEGIN

0000 : 0a000093; --addi x1, x0, 0x0A0 ;x1 holds 0x0A0
[0001..0004] : 00000013; --nop for 4 cycles to give x1 time to update
0005 : 00a08093; --addi x1, x1, 0x00A ;x1 holds 0x0AA
[0006..0009] : 00000013; --nop for 4 cycles to give x1 time to update
000A : 0f00e093; --ori x1, x1, 0x0F0 ;x1 holds 0x0FA
[000B..000E] : 00000013; --nop for 4 cycles to give x1 time to update
000F : 00f0f093; --andi x1, x1, 0x00F ;x1 holds 0x00A
[0010..0013] : 00000013; --nop for 4 cycles to give x1 time to update
0014 : 00109093; --SLLI x1, x1, 1 ;x1 holds 0x014
[0015..0018] : 00000013; --nop for 4 cycles to give x1 time to update
0019 : 0010d093; --srli x1, x1, 1 ;x1 holds 0x00A
[001A..3FFF] : 00000013; --nop
END;